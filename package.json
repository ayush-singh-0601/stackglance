{
  "name": "stackglance",
  "version": "0.1.2",
  "description": "Ambient developer intelligence for AI coding CLIs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayush-singh-0601/stackglance.git"
  },
  "homepage": "https://github.com/ayush-singh-0601/stackglance#readme",
  "bugs": {
    "url": "https://github.com/ayush-singh-0601/stackglance/issues"
  },
  "type": "module",
  "bin": {
    "stackglance": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsup && node scripts/finalize-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run verify"
  },
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "news",
    "codex",
    "claude-code",
    "gemini-cli"
  ],
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "node-pty": "^1.1.0",
    "openai": "^7.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
